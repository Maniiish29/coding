
        class Solution {
            // Function to find maximum number of consecutive steps
            // to gain an increase in altitude with each step.
            public int maxStep(int arr[]) {
                // Your code here
                int count=0;
                int n=arr.length;
                int maxcount=0;
                for(int i=1;i<n;i++){
                    if(arr[i]>arr[i-1]){
                        count++;
                        maxcount=Math.max(count,maxcount);
                    }else{
                        count=0;
                    }
                }
                return maxcount;
            }
        }
