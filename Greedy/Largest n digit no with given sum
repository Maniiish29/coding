class Solution {
    public String largestNumber(int n, int sum) {

        // Not possible to form a number
        if (sum > 9 * n || sum < 0) {
            return "-1";
        }

        char[] arr = new char[n];

        int count = sum / 9;
        int rem = sum % 9;

        // Fill with 9s
        for (int i = 0; i < count; i++) {
            arr[i] = '9';
        }

        // Fill remainder digit if there's space
        if (count < n) {
            arr[count] = (char) ('0' + rem);

            // Fill remaining positions with 0
            for (int i = count + 1; i < n; i++) {
                arr[i] = '0';
            }
        }

        return new String(arr);
    }
}
