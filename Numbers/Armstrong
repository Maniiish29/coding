class Solution {
    static boolean armstrongNumber(int n) {
        // code here
        int sum=0;
        int original=n;
        while(n>0){
            int d=n%10;
            n=n/10;
            sum=sum+d*d*d;
        }
        if(sum==original){
            return true;
        }
        else
        {
            return false;
        }
    }
}

